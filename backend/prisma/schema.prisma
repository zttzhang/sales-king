generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES
}

enum VisitResult {
  INTENT
  ORDERED
  NO_ORDER
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  password  String
  name      String
  role      UserRole     @default(SALES)
  regionId  String?
  region    Region?      @relation(fields: [regionId], references: [id])
  visits    Visit[]
  orders    SalesOrder[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([email])
  @@index([regionId])
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  stores    Store[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id        String       @id @default(cuid())
  name      String
  regionId  String?
  region    Region?      @relation(fields: [regionId], references: [id])
  address   String?
  notes     String?
  latitude  Float?
  longitude Float?
  contactName String?
  contactPhone String?
  visits    Visit[]
  orders    SalesOrder[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([regionId])
}

model Product {
  id           String           @id @default(cuid())
  name         String
  productLine  String?
  defaultPrice Decimal?         @db.Decimal(12, 2)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  orderLines   SalesOrderLine[]
}

model Customer {
  id        String       @id @default(cuid())
  name      String
  type      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  orders    SalesOrder[]
}

model Visit {
  id            String      @id @default(cuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  visitorUserId String
  visitor       User        @relation(fields: [visitorUserId], references: [id])
  visitTime     DateTime    @default(now())
  result        VisitResult
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([visitorUserId])
  @@index([storeId])
  @@index([visitTime])
}

model SalesOrder {
  id              String           @id @default(cuid())
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id])
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  createdByUserId String
  createdBy       User             @relation(fields: [createdByUserId], references: [id])
  orderDate       DateTime         @default(now())
  notes           String?
  totalAmount     Decimal          @db.Decimal(12, 2)
  totalQty        Decimal          @db.Decimal(12, 2)
  status          OrderStatus      @default(PENDING)
  lines           SalesOrderLine[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([createdByUserId])
  @@index([storeId])
  @@index([orderDate])
}

model SalesOrderLine {
  id             String     @id @default(cuid())
  orderId        String
  order          SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  qty            Decimal    @db.Decimal(12, 2)
  unitPrice      Decimal    @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  lineAmount     Decimal    @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([orderId])
  @@index([productId])
}
