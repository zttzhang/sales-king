<!--pages/admin/stores/stores.wxml-->
<view class="container">
  <!-- 搜索区域 -->
  <view class="search-section card">
    <input 
      class="search-input" 
      placeholder="搜索门店名称/地址"
      value="{{keyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
    />
    <button class="search-btn" bindtap="onSearch">搜索</button>
  </view>

  <!-- 门店列表 -->
  <view class="store-list">
    <view 
      class="store-item card" 
      wx:for="{{stores}}" 
      wx:key="id"
    >
      <view class="store-info">
        <view class="store-name">{{item.name}}</view>
        <view class="store-address">{{item.address || '暂无地址'}}</view>
        <view class="store-region" wx:if="{{item.region}}">
          区域: {{item.region.name}}
        </view>
      </view>
      <view class="store-actions">
        <button class="btn-edit" size="mini" bindtap="onEdit" data-id="{{item.id}}">编辑</button>
        <button class="btn-delete" size="mini" bindtap="onDelete" data-id="{{item.id}}">删除</button>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && stores.length === 0}}">
      <text>暂无门店数据</text>
    </view>

    <!-- 加载状态 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>

  <!-- 添加门店按钮 -->
  <view class="add-btn-container">
    <button class="add-btn" bindtap="onAdd">+ 添加门店</button>
  </view>
</view>

<!-- 表单弹窗 -->
<view class="modal" wx:if="{{showModal}}">
  <view class="modal-mask" bindtap="onModalClose"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">{{isEdit ? '编辑门店' : '添加门店'}}</text>
      <text class="modal-close" bindtap="onModalClose">×</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">门店名称 *</text>
        <input class="form-input" placeholder="请输入门店名称" value="{{formData.name}}" data-field="name" bindinput="onFormInput" />
      </view>
      <view class="form-item">
        <text class="form-label">门店地址</text>
        <input class="form-input" placeholder="请输入门店地址" value="{{formData.address}}" data-field="address" bindinput="onFormInput" />
      </view>
      <view class="form-item">
        <text class="form-label">所属区域</text>
        <picker mode="selector" range="{{regions}}" range-key="name" bindchange="onRegionChange">
          <view class="form-picker">
            {{selectedRegionName || '请选择区域'}}
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">联系人</text>
        <input class="form-input" placeholder="请输入联系人" value="{{formData.contactName}}" data-field="contactName" bindinput="onFormInput" />
      </view>
      <view class="form-item">
        <text class="form-label">联系电话</text>
        <input class="form-input" placeholder="请输入联系电话" value="{{formData.contactPhone}}" data-field="contactPhone" bindinput="onFormInput" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-cancel" bindtap="onModalClose">取消</button>
      <button class="btn-confirm" bindtap="onSubmit">确定</button>
    </view>
  </view>
</view>
