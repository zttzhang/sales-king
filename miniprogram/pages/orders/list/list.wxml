<!--pages/orders/list/list.wxml-->
<view class="container">
  <view class="list-item" wx:for="{{orders}}" wx:key="orderId">
    <view class="list-item-title">{{item.storeName}}</view>
    <view class="list-item-desc">
      <text>{{item.orderDate}}</text>
      <text class="text-primary ml-10">¥{{item.totalAmount}}</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">暂无订单</view>
</view>