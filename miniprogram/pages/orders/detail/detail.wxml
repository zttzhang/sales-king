<!--pages/orders/detail/detail.wxml-->
<view class="container">
  <!-- 订单基本信息 -->
  <view class="card order-header">
    <view class="order-info-row">
      <text class="label">订单号:</text>
      <text class="value">{{order.id}}</text>
    </view>
    <view class="order-info-row">
      <text class="label">下单日期:</text>
      <text class="value">{{order.orderDate}}</text>
    </view>
    <view class="order-info-row">
      <text class="label">门店:</text>
      <text class="value">{{order.storeName || '-'}}</text>
    </view>
    <view class="order-info-row">
      <text class="label">状态:</text>
      <text class="value status-{{order.status}}">{{getStatusText(order.status)}}</text>
    </view>
  </view>

  <!-- 商品明细 -->
  <view class="card">
    <view class="section-title">商品明细</view>
    <view class="product-list">
      <view class="product-item" wx:for="{{order.lines}}" wx:key="id">
        <view class="product-info">
          <text class="product-name">{{item.productName || '商品'}}</text>
          <text class="product-code">编码: {{item.productCode || '-'}}</text>
        </view>
        <view class="product-detail">
          <text class="qty">x{{item.qty}}</text>
          <text class="price">¥{{item.lineAmount}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单汇总 -->
  <view class="card order-summary">
    <view class="summary-row">
      <text>商品数量:</text>
      <text>{{order.totalQty || 0}} 件</text>
    </view>
    <view class="summary-row total">
      <text>订单总额:</text>
      <text class="total-amount">¥{{order.totalAmount || '0.00'}}</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card" wx:if="{{order.notes}}">
    <view class="section-title">备注</view>
    <text class="notes">{{order.notes}}</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
