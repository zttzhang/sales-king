<!--pages/orders/create/create.wxml-->
<view class="container">
  <!-- 选择门店 -->
  <view class="section card">
    <view class="section-title">选择门店 *</view>
    <picker mode="selector" range="{{stores}}" range-key="name" bindchange="onStoreChange">
      <view class="picker-value {{selectedStore ? '' : 'placeholder'}}">
        {{selectedStore.name || '请选择门店'}}
      </view>
    </picker>
  </view>

  <!-- 商品列表 -->
  <view class="section card">
    <view class="section-title">商品明细</view>
    
    <view class="product-lines">
      <view class="product-line" wx:for="{{orderLines}}" wx:key="index">
        <view class="product-line-header">
          <text class="product-name">{{item.productName}}</text>
          <text class="product-price">¥{{item.price || 0}}</text>
        </view>
        <view class="product-line-body">
          <view class="qty-control">
            <text class="qty-label">数量:</text>
            <button class="qty-btn" bindtap="onDecrease" data-index="{{index}}">-</button>
            <input class="qty-input" type="number" value="{{item.qty}}" data-index="{{index}}" bindinput="onQtyInput" />
            <button class="qty-btn" bindtap="onIncrease" data-index="{{index}}">+</button>
          </view>
          <text class="line-amount">小计: ¥{{item.lineAmount || 0}}</text>
        </view>
        <button class="btn-remove-line" bindtap="onRemoveLine" data-index="{{index}}">删除</button>
      </view>
    </view>

    <!-- 添加商品 -->
    <button class="btn-add-product" bindtap="showProductPicker">+ 添加商品</button>
  </view>

  <!-- 订单备注 -->
  <view class="section card">
    <view class="section-title">备注</view>
    <textarea class="remark-input" placeholder="请输入订单备注（可选）" value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <!-- 订单汇总 -->
  <view class="section card order-summary">
    <view class="summary-row">
      <text>商品数量:</text>
      <text>{{totalQty}}</text>
    </view>
    <view class="summary-row total">
      <text>订单总额:</text>
      <text>¥{{totalAmount || '0.00'}}</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="btn-submit" bindtap="onSubmit" disabled="{{!selectedStore || orderLines.length === 0}}">
      提交订单
    </button>
  </view>
</view>

<!-- 商品选择弹窗 -->
<view class="modal" wx:if="{{showProductModal}}">
  <view class="modal-mask" bindtap="onProductModalClose"></view>
  <view class="modal-content modal-product">
    <view class="modal-header">
      <text class="modal-title">选择商品</text>
      <text class="modal-close" bindtap="onProductModalClose">×</text>
    </view>
    <view class="modal-body">
      <input class="search-input" placeholder="搜索商品" bindinput="onProductSearch" />
      <scroll-view scroll-y class="product-list-modal">
        <view 
          class="product-item-modal" 
          wx:for="{{products}}" 
          wx:key="id"
          bindtap="onSelectProduct" 
          data-id="{{item.id}}"
        >
          <view class="product-info">
            <text class="name">{{item.name}}</text>
            <text class="code">编码: {{item.code || '无'}}</text>
          </view>
          <text class="price">¥{{item.defaultPrice || 0}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
