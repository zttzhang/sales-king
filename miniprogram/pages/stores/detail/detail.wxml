<!--pages/stores/detail/detail.wxml-->
<view class="container">
  <view class="card" wx:if="{{store}}">
    <view class="detail-item">
      <text class="detail-label">门店名称</text>
      <text class="detail-value">{{store.storeName}}</text>
    </view>
    <view class="detail-item">
      <text class="detail-label">所属区域</text>
      <text class="detail-value">{{store.regionName || '未分配'}}</text>
    </view>
    <view class="detail-item">
      <text class="detail-label">地址</text>
      <text class="detail-value">{{store.address || '暂无'}}</text>
    </view>
    <view class="detail-item">
      <text class="detail-label">备注</text>
      <text class="detail-value">{{store.notes || '暂无'}}</text>
    </view>
  </view>

  <view class="action-section">
    <navigator url="/pages/visits/create/create?storeId={{storeId}}" class="btn-primary">
      新建拜访
    </navigator>
    <navigator url="/pages/orders/create/create?storeId={{storeId}}" class="btn-primary mt-20">
      新建订单
    </navigator>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>