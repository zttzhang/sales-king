<!--pages/login/login.wxml-->
<view class="container login-container">
  <view class="logo-section">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="app-name">销售管理系统</text>
  </view>

  <view class="form-section card">
    <view class="form-item">
      <text class="form-label required">用户名</text>
      <input 
        class="form-input" 
        placeholder="请输入用户名" 
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label required">密码</text>
      <input 
        class="form-input" 
        placeholder="请输入密码" 
        password
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <button class="btn-primary mt-30" bindtap="handleLogin" disabled="{{loading}}">
      {{loading ? '登录中...' : '登录'}}
    </button>
  </view>

  <view class="tips">
    <text class="text-muted">默认管理员账号: admin / admin123</text>
  </view>
</view>