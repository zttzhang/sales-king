<!--pages/visits/create/create.wxml-->
<view class="container">
  <view class="card">
    <view class="form-item">
      <text class="form-label required">门店</text>
      <picker mode="selector" range="{{stores}}" range-key="storeName" bindchange="onStoreChange">
        <view class="form-input">{{selectedStore ? selectedStore.storeName : '请选择门店'}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label required">拜访结果</text>
      <picker mode="selector" range="{{resultOptions}}" range-key="label" bindchange="onResultChange">
        <view class="form-input">{{selectedResult ? selectedResult.label : '请选择结果'}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea 
        class="form-textarea" 
        placeholder="请输入备注" 
        value="{{notes}}"
        bindinput="onNotesInput"
      />
    </view>

    <button class="btn-primary mt-30" bindtap="handleSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交'}}
    </button>
  </view>
</view>